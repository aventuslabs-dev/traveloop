# Copy to .env.local and fill in. Never commit .env.local.

# Stripe API keys — Developers > API keys in the Stripe Dashboard.
# Use sk_test_... while developing; swap to sk_live_... only in production.
#
# The production deployment REFUSES an sk_test_ key and fails checkout with a
# clear error (src/lib/stripe.ts) rather than taking payments that never
# settle. Preview deployments are exempt — test keys are correct there.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the /api/webhooks/stripe endpoint.
# Local:      stripe listen --forward-to localhost:3000/api/webhooks/stripe  (prints whsec_...)
# Production: Developers > Webhooks > your endpoint > Signing secret
#
# Live and test mode have SEPARATE webhook endpoints and SEPARATE signing
# secrets, and both start with whsec_ — nothing in the string says which is
# which. Creating the live endpoint and leaving the test secret in place is
# the classic go-live failure: payments succeed at Stripe, every webhook fails
# signature verification, and no order is ever fulfilled. Copy the secret from
# the endpoint you created while the dashboard was in LIVE mode.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Absolute base URL Stripe redirects buyers back to after checkout.
# Required in production. Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments test mode (LOCAL DEVELOPMENT ONLY) ---
# When STRIPE_SECRET_KEY above is left as the placeholder, checkout bypasses
# Stripe and fulfils orders directly (order record + confirmation email +
# invoice), so the buyer flow can be tested before you have real Stripe keys.
# Set "false" to force real Stripe even with a placeholder key, or "true" to
# force the bypass even with real keys.
#
# This variable is IGNORED in any deployed build — it cannot hand out free
# passes on the live site. Do not set it in Vercel.
# PAYMENTS_TEST_MODE=true

# The registration form no longer asks for an email — Stripe Checkout collects
# it — so the bypass above needs one from here to exercise account creation
# and the confirmation email locally. Ignored unless the bypass is active.
# PAYMENTS_TEST_EMAIL=you@example.com

# --- Supabase (orders storage) — Project Settings > API in the Supabase Dashboard ---
# service_role bypasses RLS — server-only, never expose to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# anon/publishable key — used for admin login sessions (auth only, no RLS
# policies are granted to it, so it can't read the orders table itself).
SUPABASE_ANON_KEY=replace_me

# --- Admin panel (/admin) — Supabase Auth ---
# Create this user once: Supabase Dashboard > Authentication > Users > Add
# user, with this exact email and whatever password you want. The /admin
# login form takes "admin" as the ID (hardcoded) and maps it to this email
# behind the scenes, so the real credential Supabase checks is the password.
ADMIN_LOGIN_EMAIL=admin@traveloop.internal

# --- Email (Resend) — Developers > API Keys at https://resend.com/api-keys ---
# Leave unset to log the confirmation email + invoice to the console instead
# of sending it — useful while testing without an email account.
RESEND_API_KEY=re_replace_me

# Sender identity. Resend's shared onboarding@resend.dev sender works without
# any setup, but may restrict recipients until you verify your own sending
# domain in Resend — swap this once you have one.
EMAIL_FROM=Traveloop <onboarding@resend.dev>

# --- Contact form ---
# Where /contact enquiries are delivered. Defaults to hello@traveloop.my.
# Note: Resend only delivers to arbitrary recipients once you've verified your
# own sending domain — until then sends to this address will fail and the form
# will show the visitor a fallback message.
# CONTACT_NOTIFICATION_EMAIL=hello@traveloop.my

# --- Experience bookings ---
# Optional. Where to send a heads-up whenever a customer books a cultural
# experience that needs confirming. Leave unset to rely on /admin/bookings,
# which lists every booking either way.
# BOOKINGS_NOTIFICATION_EMAIL=bookings@traveloop.my
